# ---- NOT REDISTRIBUTABLE: the personal road-test layer --------------------
# The "My Database" layer is built from magazine road tests (auto motor und
# sport / Motor Presse Stuttgart) and their photographs. None of it may be
# published -- see ATTRIBUTION.md. Keep these patterns first and keep them.
Car Database/
app/db_pages/
app/db_photos/
app/db_match.html
app/db_match_report.json
app/db_match_overrides.json
data_src/harvest/db_match_report.txt

# ---- Local model weights: the big one -------------------------------------
# llama.cpp's -hf cache. Multi-gigabyte GGUF files, re-downloadable on demand
# by serve.py / llama_server_start.sh. Currently ~13GB -- never commit this.
llama_model_cache/

# ---- Dependencies ---------------------------------------------------------
node_modules/

# ---- Runtime logs ---------------------------------------------------------
llama_logs/
ollama_logs/
qa/mtp_test_*.log

# ---- QA screenshots -------------------------------------------------------
# Regenerated by qa/qa_*.py on demand; some historical ones showed the
# private road-test layer, so the whole class stays out.
qa/*.png

# ---- Python bytecode ------------------------------------------------------
__pycache__/
*.py[cod]

# ---- Editor / OS cruft ----------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/

# ---- Ad-hoc backups ------------------------------------------------------
# The convention this project used before it had version control. Git is the
# backup now; these were snapshots of files that are tracked here anyway.
*.bak-*
_to_delete/
testwrite.tmp

# ---- rsync / iCloud partial-transfer droppings ----------------------------
.*.??????

# Local Python virtualenv for playwright (the agent and the qa/ suites need
# it; Homebrew Python refuses a system-wide pip install under PEP 668).
.venv/
venv/

# Timestamped copies of app/llm_families.json taken before a reset (see
# scripts/reset_llm_layer.sh). Local safety net, not project history.
llm_layer_backups/
