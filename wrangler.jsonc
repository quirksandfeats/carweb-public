{
  // Cloudflare Workers deploy. app/ is served as static assets exactly as
  // before -- src/worker.js hands every path it does not own straight to the
  // ASSETS binding, so the site is unchanged for anyone who never touches the
  // request button.
  //
  // The build still has no steps. cars.json/data.js are committed with the
  // layout already baked, so there is nothing to compile at deploy time.
  "name": "carweb",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./app",
    "binding": "ASSETS"
  },

  // The request queue's storage. One job at a time lives under "job:pending"
  // and the last finished one under "job:last" -- see src/worker.js.
  "kv_namespaces": [
    { "binding": "JOBS", "id": "0f0a2ae5a4a749c4a34d10feab0357e6" }
  ]

  // Still to set, and deliberately not in this file -- they are secrets, and
  // this file is public:
  //   npx wrangler secret put REQUEST_SECRET   # the button's passphrase
  //   npx wrangler secret put AGENT_TOKEN      # the polling agent's token
  // (or Cloudflare dashboard → the carweb Worker → Settings → Variables and
  // Secrets → Add, type "Secret"). Until both exist the queue routes answer
  // "queue-unconfigured" rather than failing, and the button says so.
}
